NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API. New projects show the new key names
# (sb_publishable_... and sb_secret_...); older ones show anon / service_role.
# Either naming works: set the pair your dashboard gives you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# older projects instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# "true" lets / and /start create free games for testing. set to "false" in production.
DEV_FREE=true

# "true" keeps games in memory instead of Supabase, so the app runs with none of
# the keys above. Single process, wiped on restart: local play only, never a
# deployment. `npm run demo` sets this for you.
DEMO_MEMORY_DB=false
