{
  "name": "still-idea-film",
  "version": "1.0.0",
  "private": true,
  "description": "STILL. — 'The idea was never the problem'. 24.000s positioning film, 60fps, built entirely in code.",
  "scripts": {
    "studio": "remotion studio",
    "act1": "remotion render ActI outputs/act1-1080x1920.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "still": "remotion still ActI --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "test": "node --test --experimental-strip-types src/*.test.mts",
    "verify": "node --experimental-strip-types scripts/verify.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.3"
  }
}
